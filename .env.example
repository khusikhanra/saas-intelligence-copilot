# Copy to .env and fill in. NEVER commit the real .env file.
# Optional: without a key the app runs in offline mode (built-in routing to the same trusted analyses).
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Optional overrides (defaults shown)
# SAAS_RAW_DIR=data/raw
# SAAS_DB_PATH=data/processed/saas.duckdb
# QUERY_TIMEOUT_SECONDS=10
# QUERY_MAX_ROWS=1000
# DUCKDB_MEMORY_LIMIT=1GB
# MAX_QUESTION_CHARS=500
